import numpy as np
import numpy.typing as npt

type _Float = float | npt.NDArray[np.float64]

class Time:
    # A single instant or an array of instants. Attributes are arrays for array-valued times.

    @property
    def tt(self) -> _Float: ...
    @property
    def whole(self) -> _Float: ...
    @property
    def tdb_fraction(self) -> _Float: ...
    @property
    def delta_t(self) -> _Float: ...
    def __getitem__(self, index: npt.NDArray[np.bool_]) -> Time: ...
    def __len__(self) -> int: ...

class Timescale:
    def tt_jd(self, jd: _Float, fraction: _Float | None = None) -> Time: ...
