# Only what paleodem.py and its tests use (h5py 3.16).
from types import TracebackType
from typing import IO, Literal, Self

import numpy as np
import numpy.typing as npt

class Dataset:
    def __getitem__(self, key: tuple[()]) -> npt.NDArray[np.float32]: ...

class File:
    def __init__(self, name: str | IO[bytes], mode: Literal["r", "w"] = "r") -> None: ...
    def __getitem__(self, name: str) -> Dataset: ...
    def __contains__(self, name: str) -> bool: ...
    def create_dataset(self, name: str, *, data: npt.NDArray[np.float32]) -> Dataset: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...
