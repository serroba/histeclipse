{
  "name": "histeclipse",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "csp": "node --experimental-strip-types -e \"import('./vite.csp.ts').then((m) => console.log(m.sitePolicy()))\"",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "knip": "knip --no-progress",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "check": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm knip && pnpm typecheck && pnpm coverage && pnpm build",
    "compare:views": "node --experimental-strip-types --no-warnings e2e/views/compare.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^24.19.2",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@honeycombio/opentelemetry-web": "1.5.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-web": "0.65.0",
    "astronomia": "4.3.0",
    "onnxruntime-web": "1.31.1",
    "phoria2": "1.7.0",
    "three": "0.187.0",
    "valibot": "1.5.0"
  }
}
