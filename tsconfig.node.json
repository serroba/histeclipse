{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "vite.config.ts",
    "vite.components.config.ts",
    "vite.models.ts",
    "vite.csp.ts",
    "eslint.config.js",
    "eslint.boundaries.js",
    "coverage.untested.js",
    "stylelint.config.mjs"
  ]
}
